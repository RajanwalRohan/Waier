generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Required Models ─────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User Model ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               Profile?
  workouts              Workout[]
  meals                 Meal[]
  healthMetrics         HealthMetric[]
  wearableConnections   WearableConnection[]
  aiConversations       AIConversation[]
  workoutPresets        WorkoutPreset[]
  mealPresets           MealPreset[]
  dataDeletionRequests  DataDeletionRequest[]
  dailyScores           DailyScore[]
  streaks               Streak[]
  orbDays               OrbDay[]
  metricBaselines       MetricBaseline[]
  moodCheckIns          MoodCheckIn[]
  healthAlerts          HealthAlert[]
  ecgReadings           EcgReading[]
  goals                 Goal[]
  plans                 Plan[]
  hydrationLogs         HydrationLog[]
  modifiers             Modifier[]
  cycleEntries          CycleEntry[]
  medications           Medication[]
  medicalRecords        MedicalRecord[]
  labResults            LabResult[]
  sentFriendRequests     Friendship[] @relation("FriendRequests")
  receivedFriendRequests Friendship[] @relation("FriendOf")
  championshipMemberships ChampionshipMember[]
  progressPhotos          ProgressPhoto[]
  personalFoods           PersonalFood[]
}

// ─── Health / Fitness Profile ─────────────────────────────

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth         String?  // ISO date string (YYYY-MM-DD)
  age                 Int?     // Computed from dateOfBirth on save
  heightCm            Float?
  weightKg            Float?
  sex                 String?  // male | female | other | prefer_not_to_say
  fitnessGoal         String?  // lose_weight | gain_muscle | maintain | improve_endurance | general_health
  activityLevel       String?  // sedentary | lightly_active | moderately_active | very_active | extremely_active
  unitSystem          String   @default("imperial") // imperial | metric
  defaultRestSec      Int      @default(180) // Default rest timer between sets (live workouts)
  dietaryPreferences  String   @default("[]") // JSON array of strings
  medicalConditions   String   @default("[]") // JSON array of condition strings
  foodAllergies       String   @default("[]") // JSON array of specific food allergen strings
  medicalNotes        String?

  // ─── Goal Setting ──────────────────────────────────────
  fitnessGoals        String   @default("[]") // JSON array: gain_muscle, lose_weight, clean_bulk, clean_cut, mobility, improve_endurance, general_health, build_strength
  dietType            String?  // omnivore | vegetarian | vegan | pescatarian | keto | paleo | mediterranean | whole30
  exercisePreferences String   @default("[]") // JSON array: running, walking, jogging, weight_lifting, calisthenics, pilates, yoga, swimming, cycling, hiit, boxing, martial_arts, dancing, rock_climbing, rowing
  exerciseDaysPerWeek Int?     // how many days per week they currently exercise (0-7)
  dailyStepsGoal      Int?     // target steps per day
  sleepGoalHours      Float?   // target sleep hours per night
  goalWeightKg        Float?   // target weight in kg
  calorieGoal         Int?     // daily calorie target
  proteinGoalG        Int?     // daily protein target (grams)
  carbsGoalG          Int?     // daily carbohydrate target (grams)
  fatGoalG            Int?     // daily fat target (grams)
  hydrationGoalMl     Int?     // daily hydration target (mL) — tracked, not scored
  username            String?  @unique // public handle for the social profile
  privacySettings     String   @default("{}") // JSON: what friends/public can see
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Workouts & Exercises ─────────────────────────────────

model Workout {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  notes      String?
  durationMin Int?
  date       DateTime
  exercises  Exercise[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, date])
}

model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int?
  reps      Int?
  weightKg  Float?
  durationSec Int?
  notes     String?
  order     Int     @default(0)

  @@index([workoutId])
}

// ─── Workout Presets (reusable split templates) ──────────

model WorkoutPreset {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String            // e.g. "Chest Day", "Leg Day"
  // JSON array of integers 0-6 (Sunday=0) — days of week this preset recurs.
  // Empty array means no recurring schedule.
  recurringDays String            @default("[]")
  exercises     PresetExercise[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
}

model PresetExercise {
  id          String        @id @default(cuid())
  presetId    String
  preset      WorkoutPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  name        String
  sets        Int?
  reps        Int?
  weightKg    Float?
  durationSec Int?
  notes       String?
  order       Int           @default(0)

  @@index([presetId])
}

// ─── Nutrition / Meals ────────────────────────────────────

model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  calories    Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fiberG      Float?
  mealType    String?  // breakfast | lunch | dinner | snack
  imageUrl    String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
}

// ─── Meal Presets (one-click meal logging) ───────────────

model MealPreset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Oatmeal Bowl", "Post-Workout Shake"
  description String?
  mealType    String?  // breakfast | lunch | dinner | snack
  calories    Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fiberG      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Health Metrics (from wearables or manual) ────────────

model HealthMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // steps | heart_rate | sleep_hours | calories_burned | blood_oxygen | respiratory_rate | hrv | weight
  value     Float
  unit      String
  source    String?  // manual | fitbit | apple_health | garmin | google_fit
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId, type, date])
}

// ─── Wearable Connections ─────────────────────────────────

model WearableConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    // fitbit | apple_health | garmin | google_fit | open_wearables
  // Tokens are stored encrypted at the application layer.
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime?
  scopes          String    @default("[]") // JSON array of strings
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  externalUserId  String?   // Open Wearables user ID mapping
  providerDevice  String?   // e.g. "apple_watch_series_9", "huawei_band_6"
  tokenRotatedAt  DateTime? // Track when OAuth tokens were last refreshed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
  @@unique([externalUserId])
  @@index([userId])
}

// ─── OAuth State Tokens (CSRF protection for OAuth flows) ─

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
}

// ─── Password Reset Tokens ────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  // Store the SHA-256 hash of the token, not the plaintext.
  // The plaintext token is sent to the user via email; we only
  // store the hash so a DB leak doesn't compromise reset links.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

// ─── AI Coaching Conversations ────────────────────────────

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user | assistant | system
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ─── Audit Logging (security & compliance) ───────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // wearable_sync | data_delete | connection_revoked | connection_created | webhook_rejected
  detail    String?  // JSON metadata (metric count, source, etc.) — NEVER contains PII or health values
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─── Data Deletion Requests (GDPR-style) ─────────────────

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String    // wearable_data | all_health_data | full_account
  status      String    @default("pending") // pending | processing | completed
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

// ─── Flow: Signature Score ────────────────────────────────
// One materialized score row per user per day. rawFlow is the day's raw
// computation (0-1000); flow is the EMA-smoothed displayed value. Pillars are
// stored for the breakdown UI and are nullable when a pillar has no data.

model DailyScore {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  rawFlow     Float
  flow        Float
  heart       Float?
  motion      Float?
  recovery    Float?
  fuel        Float?
  consistency Float?
  tier        String
  division    Int?     // 3 (III) .. 1 (I); null for Maelstrom
  calibrating Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Streaks (the Bubble + secondary streaks) ─────────────

model Streak {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String    // bubble | meal | workout
  count              Int       @default(0)
  lastQualifyingDate DateTime?
  shields            Int       @default(0) // Streak Shields held (max 2)
  updatedAt          DateTime  @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// ─── Orb (daily engagement) ───────────────────────────────
// Per-day fill state. Each source contributes a percentage; the day is
// complete (filledAt set) when the combined fill reaches 100%.

model OrbDay {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  movePct    Float     @default(0)
  fuelPct    Float     @default(0)
  recoverPct Float     @default(0)
  focusPct   Float     @default(0)
  filledAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Metric Baselines (continuously-updated personal averages) ──
// A rolling mean/stddev per metric type per user, recomputed from recent
// history. Powers today-vs-typical deltas on metric detail pages.

model MetricBaseline {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricType String
  mean       Float
  stddev     Float    @default(0)
  sampleSize Int      @default(0)
  periodDays Int      @default(30)
  updatedAt  DateTime @updatedAt

  @@unique([userId, metricType])
  @@index([userId])
}

// ─── Mental Wellbeing ─────────────────────────────────────
// Optional daily self-report of mood, energy, and focus (each 1-5), to sit
// alongside wearable-derived stress. One row per user per day.

model MoodCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  mood      Int      // 1 (low) .. 5 (great)
  energy    Int      // 1 .. 5
  focus     Int      // 1 .. 5
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Periodic Health Checks ───────────────────────────────
// Detected findings from passive metrics. HR/SpO2/respiration anomalies are
// computed by Waier; irregular_rhythm and ecg findings are pass-through from
// device-cleared sources (never self-diagnosed). See PRD Regulatory Posture.

model HealthAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String    // hr_high | hr_low | spo2_dip | resp_anomaly | irregular_rhythm | ecg
  severity    String    @default("info") // info | attention | urgent
  detectedAt  DateTime
  contextJson String?   // JSON metadata (value, threshold, source) — no diagnosis
  status      String    @default("new") // new | acknowledged | dismissed
  createdAt   DateTime  @default(now())

  @@unique([userId, kind, detectedAt])
  @@index([userId, status])
  @@index([userId, detectedAt])
}

// ─── Goals (quantitative, trackable targets) ─────────────
// Turns goal categories from onboarding into concrete targets with progress
// and a finish line. Progress is computed from existing data (metrics,
// workouts, streaks), not stored, so it is always live.

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // weight | strength_pr | distance | health_metric | habit_streak | custom
  title       String
  metricType  String?   // for health_metric / weight goals: which HealthMetric type to read
  streakType  String?   // for habit_streak goals: bubble | meal | workout
  targetValue Float
  targetUnit  String?
  startValue  Float?    // snapshot at creation; null means "use first observed"
  deadline    DateTime?
  status      String    @default("active") // active | paused | completed | abandoned
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

// ─── Personal Food Library ───────────────────────────────
// The "we'll remember it" fallback: when a barcode is not in Open Food Facts,
// the user adds it once and Waier reuses it for instant logging next time.

model PersonalFood {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode   String
  name      String
  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  fiberG    Float?
  serving   String?
  createdAt DateTime @default(now())

  @@unique([userId, barcode])
  @@index([userId])
}

// ─── Progress Photos (strict-tier private) ───────────────
// Optional daily body photos and meal photos. Never public, never used for
// training. Served only through an auth + ownership-checked route. In v1 the
// image is held as a data URL; production moves to encrypted object storage
// with signed URLs (the API shape stays the same).

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  kind      String   @default("body") // body | meal
  dataUrl   String   // base64 data URL (strict tier)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ─── Waier Championship League ───────────────────────────
// Season-based head-to-head matchup leagues. v1 computes matchups and
// standings live for the current period (rotating round-robin); persisted
// matchup history and playoffs are a later enhancement.

model ChampionshipLeague {
  id          String               @id @default(cuid())
  name        String
  joinCode    String               @unique
  ownerId     String
  statsConfig String               @default("[]") // JSON array of category keys
  startDate   DateTime
  matchupDays Int                  @default(14)
  createdAt   DateTime             @default(now())
  members     ChampionshipMember[]

  @@index([ownerId])
}

model ChampionshipMember {
  id       String             @id @default(cuid())
  leagueId String
  league   ChampionshipLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime           @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
}

// ─── Social: Friendships ─────────────────────────────────
// A directed request row (userId requested friendId). Accepted friendships are
// symmetric in meaning; queries check both directions.

model Friendship {
  id        String   @id @default(cuid())
  userId    String   // requester
  friendId  String   // recipient
  status    String   @default("pending") // pending | accepted | blocked
  createdAt DateTime @default(now())
  requester User     @relation("FriendRequests", fields: [userId], references: [id], onDelete: Cascade)
  recipient User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

// ─── Medical Profile (strict-tier private) ───────────────
// Medications get a dedicated model (structured, informs Wynn safety re:
// dosing). Procedures, vaccines, and doctor visits share a flexible
// MedicalRecord. All strict tier: encrypted posture, never used for training,
// never shared.

model Medication {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dosage          String?
  frequency       String?
  startDate       DateTime?
  endDate         DateTime?
  prescriber      String?
  reminderEnabled Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model MedicalRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // procedure | vaccine | doctor_visit
  name         String
  date         DateTime?
  providerName String?
  detail       String?  // lot number, reason, notes
  createdAt    DateTime @default(now())

  @@index([userId, type])
}

// ─── Lab Results (strict-tier private) ───────────────────

model LabResult {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testName        String    // e.g. "LDL", "HbA1c"
  value           Float
  unit            String?
  refRangeLow     Float?
  refRangeHigh    Float?
  panel           String?   // e.g. "Lipid Panel"
  collectedAt     DateTime
  sourceUploadRef String?   // encrypted reference if imported from a document
  createdAt       DateTime  @default(now())

  @@index([userId, testName, collectedAt])
}

// ─── Cycle Tracking (strict-tier private) ────────────────
// Period, symptom, and phase logging. Strict tier: never used in percentiles,
// leagues, or any shared surface, and excluded by default from Wrapped.

model CycleEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  kind      String   // period_start | period_end | symptom
  flow      String?  // light | medium | heavy (period days)
  symptoms  String?  // JSON array of symptom strings
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ─── Hydration (tracked, NOT scored) ─────────────────────
// Water intake against a daily goal. Deliberately excluded from Flow and from
// the Orb's fill sources because self-reported intake is trivially gameable.

model HydrationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ─── Modifiers (caffeine, alcohol, supplements, sleep aids) ──
// Logged for context (Wynn correlations), never scored, never on competitive
// surfaces.

model Modifier {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    String   // caffeine | alcohol | supplement | sleep_aid
  name    String?
  amount  Float?
  unit    String?  // mg | drinks | g | mcg | ...
  takenAt DateTime
  note    String?

  @@index([userId, takenAt])
}

// ─── Coaching Plans ───────────────────────────────────────
// A Plan is a day-by-day schedule (training or nutrition) optionally tied to a
// Goal. Items are followed and checked off; v1 generates plans from a template
// calibrated to the user's profile, with AI authoring as a later enhancement.

model Plan {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId           String?    // soft link to a Goal (no FK to keep deletes simple)
  name             String
  kind             String     // training | nutrition
  startDate        DateTime
  endDate          DateTime
  status           String     @default("active") // active | paused | completed | archived
  adaptationPolicy String?    // informational in v1
  items            PlanItem[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId, status])
}

model PlanItem {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  date      DateTime
  kind      String   // workout | meal | habit | rest
  title     String
  payload   String?  // JSON details (focus, macros, etc.)
  completed Boolean  @default(false)
  order     Int      @default(0)

  @@index([planId, date])
}

// ─── ECG Readings (scaffold; device pass-through, Phase 3) ─

model EcgReading {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capturedAt     DateTime
  heartRate      Int?
  classification String?  // device-provided, e.g. "sinus_rhythm" | "afib" | "inconclusive"
  deviceProvider String?
  waveformRef    String?  // encrypted reference; bytes never in the primary DB
  createdAt      DateTime @default(now())

  @@index([userId, capturedAt])
}
