# ============================================================
# AI Health Coach — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/ai_health_coach?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# --- AI Provider (at least one required) ---
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# --- Wearable OAuth (optional — configure per provider) ---
# FITBIT_CLIENT_ID=""
# FITBIT_CLIENT_SECRET=""
# GARMIN_CLIENT_ID=""
# GARMIN_CLIENT_SECRET=""
# GOOGLE_FIT_CLIENT_ID=""
# GOOGLE_FIT_CLIENT_SECRET=""

# --- Encryption (for OAuth tokens at rest) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Upload ---
UPLOAD_MAX_SIZE_MB=5

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# --- Node ---
NODE_ENV=development
